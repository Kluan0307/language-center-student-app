# Gateway public configuration only. Development may use the computer LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080/api/v1

# Internal APK/release: override API with a reachable HTTPS URL ending in /api/v1.
# Never publish database, JWT, payment signing or push server secrets here.
# EXPO_PUBLIC_CENTER_PHONE=<official center contact phone>

# Optional native push after creating your own EAS/Firebase project.
EXPO_PUBLIC_EAS_PROJECT_ID=
# EXPO_ANDROID_PACKAGE=com.languagecenter.student
# EXPO_ANDROID_GOOGLE_SERVICES_JSON=<local path or EAS file environment variable>
